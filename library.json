{
  "name": "LDC1614",
  "version": "3.0.0",
  "description": "Framework-neutral cooperative LDC1614/LDC1612 28-bit inductance-to-digital converter driver",
  "keywords": [
    "ldc1614",
    "ldc1612",
    "inductance",
    "ldc",
    "inductive-sensing",
    "i2c",
    "28-bit",
    "esp-idf"
  ],
  "authors": [
    {
      "name": "Thymos Solution s.r.o",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz"
    },
    {
      "name": "Jan Havelka",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/LDC1614.git"
  },
  "license": "MIT",
  "homepage": "https://www.thymos.cz",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "LDC1614/LDC1614.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  },
  "export": {
    "include": [
      "include/**",
      "src/**",
      "examples/**",
      "scripts/generate_version.py",
      "CMakeLists.txt",
      "CONTRIBUTING.md",
      "Doxyfile",
      "docs/README.md",
      "docs/HARDWARE_INTEGRATION.md",
      "docs/HIL_VALIDATION.md",
      "docs/I2C_INTEGRATION.md",
      "docs/IDF_PORT.md",
      "docs/TUNNELMONITOR_INTEGRATION_GATES.md",
      "docs/VALIDATION_STATUS.md",
      "docs/reference/LDC1614_datasheet.pdf",
      "idf_component.yml",
      "library.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      ".git/**",
      ".github/**",
      ".pio/**",
      ".vscode/**",
      "test/**",
      "tools/**",
      "prompts/**",
      "*.tar.gz",
      "*.tgz",
      "*.zip"
    ]
  }
}
